# =============================================================================
# Plateforme RH — Variables d'environnement
# =============================================================================

# ── Environnement ─────────────────────────────────────────────────────────
APP_ENV=development

# ── Sécurité ──────────────────────────────────────────────────────────────
# Généré automatiquement — copiez la sortie de ces commandes :
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-key-here
FIELD_ENCRYPTION_KEY=your-field-encryption-key-here

# ── Base de données PostgreSQL ─────────────────────────────────────────────
# Format : postgresql+psycopg2://utilisateur:motdepasse@hote:port/nom_base
DATABASE_URL=postgresql+psycopg2://postgres:0000@localhost:5432/schema_rh
TEST_DATABASE_URL=postgresql+psycopg2://postgres:0000@localhost:5432/schema_rh_test
STAGING_DATABASE_URL=postgresql+psycopg2://postgres:0000@localhost:5432/schema_rh

# ── Redis (optionnel en dev — désactivé si absent) ─────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Email SMTP ────────────────────────────────────────────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=votre@email.com
MAIL_PASSWORD=votre_app_password
MAIL_SENDER_NAME=Plateforme RH
MAIL_SENDER_ADDRESS=noreply@votre-entreprise.fr

# ── Stockage fichiers ──────────────────────────────────────────────────────
UPLOAD_FOLDER=storage/uploads